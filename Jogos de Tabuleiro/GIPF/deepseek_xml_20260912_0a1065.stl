<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 550" width="100%" height="100%">
  <defs>
    <!-- Definição do círculo padrão para garantir tamanho idêntico -->
    <circle id="node" r="5" fill="black" />
  </defs>

  <!-- Linhas da grade -->
  <g stroke="black" stroke-width="2" fill="none">
    <!-- Linhas Verticais -->
    <line x1="100" y1="100" x2="100" y2="450" />
    <line x1="150" y1="75" x2="150" y2="475" />
    <line x1="200" y1="50" x2="200" y2="500" />
    <line x1="250" y1="25" x2="250" y2="525" />
    <line x1="300" y1="50" x2="300" y2="500" />
    <line x1="350" y1="75" x2="350" y2="475" />
    <line x1="400" y1="100" x2="400" y2="450" />

    <!-- Linhas Diagonais (Descendo da Esquerda para Direita) -->
    <line x1="50" y1="150" x2="450" y2="450" />
    <line x1="100" y1="125" x2="400" y2="425" />
    <line x1="150" y1="100" x2="350" y2="400" />
    <line x1="200" y1="75" x2="300" y2="375" />
    <line x1="250" y1="50" x2="250" y2="350" /> <!-- Central -->
    <line x1="300" y1="75" x2="200" y2="375" />
    <line x1="350" y1="100" x2="150" y2="400" />
    <line x1="400" y1="125" x2="100" y2="425" />
    <line x1="450" y1="150" x2="50" y2="450" />

    <!-- Linhas Diagonais (Descendo da Direita para Esquerda) -->
    <line x1="50" y1="450" x2="450" y2="150" />
    <line x1="100" y1="425" x2="400" y2="125" />
    <line x1="150" y1="400" x2="350" y2="100" />
    <line x1="200" y1="375" x2="300" y2="75" />
    <line x1="250" y1="350" x2="250" y2="50" /> <!-- Central -->
    <line x1="300" y1="375" x2="200" y2="75" />
    <line x1="350" y1="400" x2="150" y2="100" />
    <line x1="400" y1="425" x2="100" y2="125" />
    <line x1="450" y1="450" x2="50" y2="150" />
    
    <!-- Linhas de conexão das bordas (pontas soltas) -->
    <line x1="250" y1="25" x2="250" y2="0" />
    <line x1="250" y1="525" x2="250" y2="550" />
    <line x1="50" y1="150" x2="30" y2="150" />
    <line x1="450" y1="150" x2="470" y2="150" />
    <line x1="50" y1="450" x2="30" y2="450" />
    <line x1="450" y1="450" x2="470" y2="450" />
  </g>

  <!-- Círculos (Nós) -->
  <g>
    <!-- Linha 1 -->
    <use href="#node" x="100" y="100" />
    <use href="#node" x="150" y="75" />
    <use href="#node" x="200" y="50" />
    <use href="#node" x="250" y="25" />
    <use href="#node" x="300" y="50" />
    <use href="#node" x="350" y="75" />
    <use href="#node" x="400" y="100" />
    
    <!-- Linha 2 -->
    <use href="#node" x="50" y="150" />
    <use href="#node" x="100" y="125" />
    <use href="#node" x="150" y="100" />
    <use href="#node" x="200" y="75" />
    <use href="#node" x="250" y="50" />
    <use href="#node" x="300" y="75" />
    <use href="#node" x="350" y="100" />
    <use href="#node" x="400" y="125" />
    <use href="#node" x="450" y="150" />

    <!-- Linha 3 -->
    <use href="#node" x="50" y="250" />
    <use href="#node" x="100" y="225" />
    <use href="#node" x="150" y="200" />
    <use href="#node" x="200" y="175" />
    <use href="#node" x="250" y="150" />
    <use href="#node" x="300" y="175" />
    <use href="#node" x="350" y="200" />
    <use href="#node" x="400" y="225" />
    <use href="#node" x="450" y="250" />

    <!-- Linha 4 -->
    <use href="#node" x="50" y="350" />
    <use href="#node" x="100" y="325" />
    <use href="#node" x="150" y="300" />
    <use href="#node" x="200" y="275" />
    <use href="#node" x="250" y="250" />
    <use href="#node" x="300" y="275" />
    <use href="#node" x="350" y="300" />
    <use href="#node" x="400" y="325" />
    <use href="#node" x="450" y="350" />

    <!-- Linha 5 -->
    <use href="#node" x="50" y="450" />
    <use href="#node" x="100" y="425" />
    <use href="#node" x="150" y="400" />
    <use href="#node" x="200" y="375" />
    <use href="#node" x="250" y="350" />
    <use href="#node" x="300" y="375" />
    <use href="#node" x="350" y="400" />
    <use href="#node" x="400" y="425" />
    <use href="#node" x="450" y="450" />

    <!-- Linha 6 -->
    <use href="#node" x="100" y="525" />
    <use href="#node" x="150" y="500" />
    <use href="#node" x="200" y="475" />
    <use href="#node" x="250" y="450" />
    <use href="#node" x="300" y="475" />
    <use href="#node" x="350" y="500" />
    <use href="#node" x="400" y="525" />

    <!-- Linha 7 (Pontas soltas) -->
    <use href="#node" x="250" y="0" />
    <use href="#node" x="250" y="550" />
    <use href="#node" x="30" y="150" />
    <use href="#node" x="470" y="150" />
    <use href="#node" x="30" y="450" />
    <use href="#node" x="470" y="450" />
  </g>
</svg>